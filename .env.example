VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Server-side only — never use VITE_ prefix for service role keys.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Used only for server-backed profile/admin helpers.
# Normal diagnosis/questions/results must work without this server.
VITE_API_BASE_URL=https://mebody-server-production.up.railway.app

VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# ---------------------------------------------------------------------------
# AdMob 광고 단위 ID (네이티브 앱에서만 사용)
# 앱 ID 는 capacitor.config.ts + android/app/src/main/AndroidManifest.xml 에 있습니다.
# 아래 값이 비어 있으면 Google 공식 "테스트 광고" 가 나갑니다 — 개발 중에는 그대로 두세요.
# 실 광고 단위를 넣고 테스트하면 정책 위반(무효 트래픽)이 될 수 있습니다.
#
# 형식: ca-app-pub-<게시자16자리>/<단위10자리>   ← '/' 입니다. '~' 는 앱 ID 입니다.
# ---------------------------------------------------------------------------
VITE_ADMOB_BANNER_RESULT=
VITE_ADMOB_BANNER_ROUTINE=
VITE_ADMOB_REWARDED=

# ---------------------------------------------------------------------------
# 결과 공유
# ---------------------------------------------------------------------------
# 카카오톡 공유용 JavaScript 키. 비어 있으면 SDK 를 내려받지 않고 카카오 버튼만 숨깁니다.
# (OS 공유·링크 복사는 키 없이도 동작합니다)
# Kakao Developers → 앱 → JavaScript 키 → 플랫폼 Web 에 도메인 등록 → 카카오톡 공유 활성화
VITE_KAKAO_JAVASCRIPT_KEY=

# 공유 링크에 쓸 기준 주소. 비워두면 브라우저에서는 현재 origin 을 씁니다.
# 네이티브 앱(Capacitor)은 origin 이 localhost 라서 이 값이 없으면 배포 주소로 대체합니다.
VITE_PUBLIC_SITE_URL=
