<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 이상의 백업·기기이전 범위 (2026-09-27 점검 P1-7).
  backup_rules.xml 과 같은 이유로 웹뷰 저장소를 뺍니다. 자세한 설명은 그쪽 주석에 있습니다.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="app_webview" />
    <exclude domain="database" path="" />
    <exclude domain="sharedpref" path="" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="app_webview" />
    <exclude domain="database" path="" />
    <exclude domain="sharedpref" path="" />
  </device-transfer>
</data-extraction-rules>
